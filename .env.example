# SAGE local development defaults (no PostgreSQL and no external vector API)
MINIONS_SAGE_MODE=development
MINIONS_SAGE_STORE=sqlite
MINIONS_SAGE_EMBEDDING_PROVIDER=local-hash
MINIONS_SAGE_EMBEDDING_DIMENSIONS=384
MINIONS_SAGE_EMBEDDING_TIMEOUT_SECONDS=1.5
MINIONS_SAGE_EMBEDDING_BACKFILL_LIMIT=50

# Optional production embedding endpoint. Keep secrets in a secret manager.
# MINIONS_SAGE_EMBEDDING_PROVIDER=openai-compatible
# MINIONS_SAGE_EMBEDDING_BASE_URL=https://embedding.example.com/v1
# MINIONS_SAGE_EMBEDDING_MODEL=your-embedding-model
# MINIONS_SAGE_EMBEDDING_DIMENSIONS=1536
# MINIONS_SAGE_EMBEDDING_API_KEY=
